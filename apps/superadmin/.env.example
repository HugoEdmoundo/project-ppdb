VITE_API_URL=http://localhost:8000

# Dummy auth (dev-only): set true agar halaman login tidak memanggil backend,
# memakai user dummy. Biarkan kosong/false di produksi.
VITE_MOCK_AUTH=

# WhatsApp Microservice tidak lagi dikonfigurasi di frontend.
# Semua lalu lintas WA lewat proxy FastAPI (backend env WA_SERVICE_URL /
# WA_SERVICE_API_KEY) di apps/api/.env — tidak ada VITE_WA_* di panel ini.
