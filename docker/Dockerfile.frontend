# ============================================================
# PTDARRAHMAN — FRONTEND CONTAINER (Node/pnpm → HANYA menyajikan UI)
# ============================================================
# Build context: repository ROOT (./)
#
# Isi image ini HANYA 3 buah frontend:
#   - companyprofile (Next.js 16)  → port 3000  (next start)
#   - ppdb            (Vite/React) → port 5173  (vite preview)
#   - superadmin      (Vite/React) → port 5174  (vite preview)
#
# Tidak ada backend/DB/Redis/WhatsApp di container ini. Semua lalu lintas API
# diarahkan ke service `api` (FastAPI) lewat Build ARG:
#   --build-arg NEXT_PUBLIC_API_URL=http://localhost:8080
#   --build-arg VITE_API_URL=http://localhost:8080
#
# WhatsApp microservice (apps/whatsapp) TIDAK termasuk pnpm workspace — ia
# service Node/npm sendiri yang berjalan di container terpisah.
#
# CATATAN BUILD (pnpm 9 via Docker):
#   Satu stage builder agar pnpm install + source copy + build di stage yang
#   sama. Symlink node_modules per paket workspace (yang dibuat pnpm saat
#   install) TIDAK hilang oleh COPY berikutnya — Docker COPY hanya menyalin
#   file yang ada di source, tidak menghapus node_modules yang sudah ada.
#   Skema lama (copy node_modules antar-stage) menghasilkan symlink per-paket
#   hilang → "package.json exists but node_modules missing".
# ============================================================

ARG NODE_VERSION=22

# ── Stage: builder — install + build seluruh UI ──────────────────────────────
FROM node:${NODE_VERSION}-slim AS builder
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare pnpm@9.10.0 --activate

WORKDIR /workspace

# Copy manifer workspace saja → docker layer cache optimal
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/typescript-config/package.json ./packages/typescript-config/package.json
COPY apps/companyprofile/package.json ./apps/companyprofile/package.json
COPY apps/ppdb/package.json ./apps/ppdb/package.json
COPY apps/superadmin/package.json ./apps/superadmin/package.json

# Install terlebih dahulu (pnpm 9: build scripts berjalan → sharp/esbuild th-build untuk linux)
# Network flaky: cache-mount pnpm store agar install yang terputus lanjut dari
# cache antar-build, plus retry & concurrency rendah.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --fetch-retries=8 --network-concurrency=4

# Source — node_modules per paket yang sudah ada dipertahankan oleh COPY
COPY packages/ ./packages/
COPY apps/companyprofile/ ./apps/companyprofile/
COPY apps/ppdb/ ./apps/ppdb/
COPY apps/superadmin/ ./apps/superadmin/

# URL API yang di-bake ke bundle client. Sesuaikan dengan publish port service `api`.
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG VITE_API_URL=http://localhost:8080
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV VITE_API_URL=${VITE_API_URL}

RUN pnpm build

# ── Stage: runtime — serve UI only ──────────────────────────────────────────
FROM node:${NODE_VERSION}-slim AS runtime
ENV NODE_ENV=production
WORKDIR /workspace

COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/pnpm-workspace.yaml /workspace/pnpm-lock.yaml /workspace/package.json /workspace/turbo.json ./
COPY --from=builder /workspace/packages ./packages
COPY --from=builder /workspace/apps ./apps

COPY docker/frontend-entrypoint.sh /usr/local/bin/frontend-entrypoint.sh
RUN chmod +x /usr/local/bin/frontend-entrypoint.sh

EXPOSE 3000 5173 5174

CMD ["/usr/local/bin/frontend-entrypoint.sh"]
