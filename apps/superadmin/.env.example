VITE_API_URL=http://localhost:8000

# Base URL situs publik untuk action "Lihat Situs" di header/sidebar.
# Opsional — kalau kosong, dideteksi dari hostname (produksi -> ptdarrahman.sch.id,
# dev -> port 3000). Dipakai oleh resolveCompanyProfileUrl() di packages/ui.
VITE_COMPANY_PROFILE_URL=http://localhost:3000

# WhatsApp Microservice tidak lagi dikonfigurasi di frontend.
# Semua lalu lintas WA lewat proxy FastAPI (backend env WA_SERVICE_URL /
# WA_SERVICE_API_KEY) di apps/api/.env — tidak ada VITE_WA_* di panel ini.
