# ===== Database (MySQL) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ptdarrahman
MYSQL_SSL=false

# ===== JWT =====
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-hex-string
JWT_EXPIRY_HOURS=24

# ===== CORS =====
# Comma-separated list of allowed origins. "*" = allow all (dev only).
CORS_ORIGINS=*

# ===== Uploads =====
# provider: cloudinary | local  (local = ephemeral disk, dev only)
UPLOAD_PROVIDER=cloudinary
UPLOAD_DIR=uploads

# Cloudinary credentials (cloudinary.com -> dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ptdarrahman
CLOUDINARY_SECURE=true

# ===== Seeding (scripts/seed.py) =====
# Leave empty to skip creating/updating the superadmin account.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_EMAIL=
