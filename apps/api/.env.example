# ===== Database (MySQL) =====
# Atau set DATABASE_URL langsung (e.g. sqlite:///./dev.db untuk local dev)
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/ptdarrahman
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ptdarrahman
MYSQL_SSL=false

# ===== JWT =====
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-hex-string
JWT_EXPIRY_HOURS=24

# ===== CORS =====
# "*" = allow semua origin (dev only; credentials nonaktif).
# Kosong (default) = allowlist bawaan + regex:
#   - localhost/127.0.0.1 port berapa pun
# Isi dengan daftar origin eksplisit bila perlu (dipisah koma).
CORS_ORIGINS=
# Regex tambahan untuk origin dinamis (misal preview domain), opsional.
CORS_ORIGIN_REGEX=

# ===== Uploads =====
# provider: local | cloudinary | db
UPLOAD_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudinary (opsional, kosongkan jika pakai local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ptdarrahman
CLOUDINARY_SECURE=true

# ===== Frontend URLs (for notification links) =====
PPDB_FRONTEND_URL=http://localhost:5173
