# ============================================================
# PTDARRAHMAN API — Production Environment Template
# Copy ke .env dan isi semua field yang wajib diisi.
# JANGAN commit file .env ke repository.
# ============================================================

# ── Database (MySQL) ──────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ptdarrahman
MYSQL_PASSWORD=ganti_dengan_password_kuat
MYSQL_DATABASE=ptdarrahman
# Set true jika MySQL server mewajibkan koneksi SSL
MYSQL_SSL=false

# ── Redis ─────────────────────────────────────────────────────────────────────
# Dipakai oleh rate limiter (multi-worker safe) dan user-session cache.
# Format: redis://:password@host:port/db
# Contoh Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
# TTL cache user-session dalam detik (default 300 = 5 menit)
USER_CACHE_TTL=300

# ── JWT ───────────────────────────────────────────────────────────────────────
# Wajib: min 32 karakter random
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti_dengan_string_panjang_acak_minimal_32_karakter
JWT_EXPIRY_HOURS=24

# ── Cron ──────────────────────────────────────────────────────────────────────
# Wajib: min 16 karakter random
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
CRON_SECRET=ganti_dengan_string_panjang_acak_minimal_16_karakter

# ── Cookies ───────────────────────────────────────────────────────────────────
# true = cookie hanya dikirim via HTTPS (wajib di produksi)
# false = boleh via HTTP (development saja)
# Catatan: jika di-deploy di belakang reverse proxy HTTPS, set true.
COOKIE_SECURE=true

# ── Payment Gateway (Midtrans) ────────────────────────────────────────────────
# Kosongkan jika pembayaran hanya offline/manual
MIDTRANS_SERVER_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Contoh produksi: https://ppdb.ptdarrahman.sch.id,https://admin.ptdarrahman.sch.id
# Kosong = allow localhost:* saja (development)
CORS_ORIGINS=
# Regex opsional untuk origin dinamis (misal preview domain CI/CD)
CORS_ORIGIN_REGEX=

# ── Frontend URLs (untuk deep-link di notifikasi) ─────────────────────────────
PPDB_FRONTEND_URL=https://ppdb.ptdarrahman.sch.id
SUPERADMIN_FRONTEND_URL=https://admin.ptdarrahman.sch.id

# ── WhatsApp Microservice ─────────────────────────────────────────────────────
# URL ke apps/whatsapp/ (Docker networking: http://whatsapp:3100)
WA_SERVICE_URL=http://whatsapp:3100
# Harus sama dengan API_KEY di apps/whatsapp/.env
WA_SERVICE_API_KEY=
# Harus sama dengan WEBHOOK_SECRET di apps/whatsapp/.env
WA_WEBHOOK_SECRET=

# ── File Uploads ──────────────────────────────────────────────────────────────
# provider: local | cloudinary | db
UPLOAD_PROVIDER=local
# Path folder uploads (di-mount sebagai Docker volume)
UPLOAD_DIR=uploads

# Cloudinary (opsional, isi jika UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ptdarrahman
CLOUDINARY_SECURE=true
