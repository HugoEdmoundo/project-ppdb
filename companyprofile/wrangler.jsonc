{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "companyprofile-ptdarrahman",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    // Enable Node.js API compatibility for Next.js
    "nodejs_compat",
    // Allow fetching public URLs from the Worker
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match the "name" of this worker
      "service": "companyprofile-ptdarrahman"
    }
  ]
  // Optional: enable Next.js image optimization via Cloudflare Images:
  // "images": { "binding": "IMAGES" }
  // Optional: enable Next.js incremental cache via Cloudflare R2:
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "companyprofile-cache" }
  // ]
}
