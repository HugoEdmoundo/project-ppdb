# ============================================================
# WhatsApp Microservice — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# Server
NODE_ENV=development
PORT=3100
HOST=0.0.0.0

# API Key — gunakan string random panjang ≥ 32 karakter
API_KEY=change-me-to-a-random-secret-at-least-32-chars

# ── MySQL ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ptdarrahman

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis DB index (0-15). Gunakan index berbeda dari service lain.
REDIS_DB=1

# ── Puppeteer / whatsapp-web.js ───────────────────────────
# Path ke executable Chrome/Chromium yang sudah terinstall di server.
# Kosongkan untuk menggunakan bundled Chromium dari puppeteer.
CHROMIUM_EXECUTABLE_PATH=

# Path di mana session data WhatsApp disimpan (di-mount sebagai Docker volume).
WA_SESSION_PATH=./wa-session

# ── Rate Limiting ─────────────────────────────────────────
# Request per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# WA message throttle — maks pesan per menit yang dikirim ke WhatsApp
WA_THROTTLE_PER_MINUTE=20

# ── Webhook (callback ke FastAPI) ────────────────────────
# URL backend FastAPI yang menerima callback delivery status
WEBHOOK_URL=http://localhost:8080/notifications/webhook/whatsapp
# Secret untuk HMAC signature webhook
WEBHOOK_SECRET=change-me-webhook-secret

# ── Logging ───────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
# Path untuk menyimpan log file. Kosongkan untuk stdout only.
LOG_FILE_PATH=./logs
